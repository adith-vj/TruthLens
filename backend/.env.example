# TruthLens Backend — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# External API Keys
# ---------------------------------------------------------------------------

# Google Fact Check Tools API key
# Obtain from: https://developers.google.com/fact-check/tools/api/reference/rest
# Required for Phase 2 (Google Fact Check integration). Leave empty during scaffolding.
GOOGLE_FACTCHECK_API_KEY=

# Google Gemini API key
# Obtain from: https://aistudio.google.com/app/apikey
# Required for Phase 3 (hybrid claim classifier — Gemini fallback).
# Leave empty to disable Gemini classification (rule-based heuristics still run).
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# CORS Configuration
# ---------------------------------------------------------------------------

# Allowed origins for CORS. Must be a JSON array string.
# For local development:
#   ALLOWED_ORIGINS=["*"]
# For production, set to your Chrome Extension origin:
#   ALLOWED_ORIGINS=["chrome-extension://<your-extension-id>"]
# Find your extension ID in chrome://extensions after loading the unpacked extension.
ALLOWED_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# Input Validation
# ---------------------------------------------------------------------------

# Maximum number of characters allowed in the "text" field of POST /api/verify.
# Claims longer than this will be rejected with a 422 error.
MAX_CLAIM_LENGTH=2000

# ---------------------------------------------------------------------------
# Google Fact Check Client
# ---------------------------------------------------------------------------

# Timeout in seconds for each request to the Google Fact Check API.
# Increase if you observe frequent timeout errors; lower to reduce latency impact.
FACTCHECK_TIMEOUT_SECONDS=5.0

# Maximum number of claims to request per API call (Google's pageSize parameter).
# The first claim with a valid claimReview is selected; values above 5 rarely help.
FACTCHECK_MAX_RESULTS=5

# ---------------------------------------------------------------------------
# Gemini Classifier Client
# ---------------------------------------------------------------------------

# Timeout in seconds for each Gemini API call during claim classification.
# The classifier is a fast, cheap call; keep this value low.
CLASSIFIER_TIMEOUT_SECONDS=5.0

# ---------------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------------

# Logging verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
# WARNING: DEBUG level will include the Google API key in httpx request URL logs.
# Never set DEBUG in production.
LOG_LEVEL=INFO

# Application environment tag. Used in /health response and log output.
# One of: development, staging, production
APP_ENV=development

# ---------------------------------------------------------------------------
# Phase 4: Tavily AI Web Search
# ---------------------------------------------------------------------------

# Tavily AI search API key.
# Obtain a free key (1,000 credits/month, no credit card required) at:
#   https://app.tavily.com
# search_depth is always "basic" in TruthLens (1 credit/request).
# "advanced" costs 2 credits/request and would halve the effective free quota.
TAVILY_API_KEY=

# Timeout in seconds for each Tavily search request.
SEARCH_TIMEOUT_SECONDS=8.0

# Maximum number of Tavily results to request per search call.
# Each result costs 1 credit on search_depth="basic".
SEARCH_MAX_RESULTS=5

# ---------------------------------------------------------------------------
# Phase 4: LLM Verifier (Gemini)
# ---------------------------------------------------------------------------

# The LLM verifier reuses GEMINI_API_KEY (already set above).
# Model: gemini-2.5-flash (GA, free tier confirmed August 2026).
# Timeout in seconds for each Gemini verifier request.
# This is higher than CLASSIFIER_TIMEOUT_SECONDS because the verifier produces
# structured JSON output with reasoning, which takes longer than classification.
LLM_TIMEOUT_SECONDS=15.0
